# Copy to .env in the repository root. Keep real credentials out of Git.
# Replace <db_password> with the URL-encoded DATABASE USER password.
# MONGODB_URI=mongodb+srv://abhishekkaryan16_db_user:<db_password>@ci-memory-dev.yhaees2.mongodb.net/?appName=ci-memory-dev
MONGODB_URI=
MONGODB_DB=ci_memory
PORT=3001
CI_TEAM_ID=hackathon
CI_REPOSITORY_ID=iamabhishek841/ci-memory_mongodb
# Hosted writes require a secret of at least 24 characters. Render generates it.
# DEMO_WRITE_TOKEN=
# PUBLIC_ORIGIN=https://your-service.onrender.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
